+package com.android.systemui.statusbar.chips.music.ui.viewmodel
+
+import android.content.Context
+import android.provider.Settings
+import androidx.compose.runtime.snapshotFlow
+import com.android.systemui.dagger.SysUISingleton
+import com.android.systemui.dagger.qualifiers.Application
+import com.android.systemui.dagger.qualifiers.Main
+import com.android.systemui.media.remedia.data.model.MediaDataModel
+import com.android.systemui.media.remedia.data.repository.MediaRepository
+import com.android.systemui.statusbar.chips.ui.model.ColorsModel
+import com.android.systemui.statusbar.chips.ui.model.OngoingActivityChipModel
+import com.android.systemui.statusbar.chips.ui.viewmodel.OngoingActivityChipViewModel
+import javax.inject.Inject
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.SharingStarted
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.stateIn
+
+/**
+ * View model for the "now playing" music chip shown in the status bar island.
+ *
+ * The chip mirrors the most recent active media session (title + app icon). It is ranked as a
+ * secondary chip, so it appears next to a call or notification chip when one is present, and on
+ * its own otherwise. It can be turned off with the [SETTING_KEY] secure setting.
+ */
+@SysUISingleton
+class MusicChipViewModel
+@Inject
+constructor(
+    @Application private val scope: CoroutineScope,
+    @Main private val context: Context,
+    private val mediaRepository: MediaRepository,
+) : OngoingActivityChipViewModel {
+
+    /** The first active media session, or null when nothing is playing. */
+    private val activeMedia: Flow<MediaDataModel?> = snapshotFlow {
+        mediaRepository.currentMedia.firstOrNull { it.isActive }
+    }
+
+    override val chip: StateFlow<OngoingActivityChipModel> =
+        activeMedia
+            .map { media ->
+                if (media == null || !isEnabled()) {
+                    OngoingActivityChipModel.Inactive()
+                } else {
+                    media.toChipModel()
+                }
+            }
+            // See b/347726238 for [SharingStarted.Lazily] reasoning.
+            .stateIn(scope, SharingStarted.Lazily, OngoingActivityChipModel.Inactive())
+
+    private fun isEnabled(): Boolean =
+        try {
+            Settings.System.getInt(context.contentResolver, SETTING_KEY, ENABLED_BY_DEFAULT) == 1
+        } catch (e: RuntimeException) {
+            ENABLED_BY_DEFAULT == 1
+        }
+
+    private fun MediaDataModel.toChipModel(): OngoingActivityChipModel.Active {
+        return OngoingActivityChipModel.Active(
+            key = KEY,
+            notificationKey = null, // Not tied to a notification
+            icon = OngoingActivityChipModel.ChipIcon.SingleColorIcon(appIcon),
+            content = OngoingActivityChipModel.Content.Text(title),
+            colors = ColorsModel.SystemThemed,
+            clickBehavior = OngoingActivityChipModel.ClickBehavior.None,
+        )
+    }
+
+    companion object {
+        /** Key used as the chip identity so the island can animate updates in place. */
+        const val KEY = "MusicChip"
+
+        /** System setting (0 = off, 1 = on) that the Settings app writes to. */
+        const val SETTING_KEY = "music_dynamic_island_enabled"
+
+        private const val ENABLED_BY_DEFAULT = 1
+    }
+}
