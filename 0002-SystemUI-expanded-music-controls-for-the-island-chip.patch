+package com.android.systemui.statusbar.chips.music.ui.view
+
+import android.content.Context
+import android.graphics.Typeface
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.text.TextUtils
+import android.view.View
+import android.widget.ImageButton
+import android.widget.LinearLayout
+import android.widget.SeekBar
+import android.widget.TextView
+import com.android.systemui.media.controls.shared.model.MediaAction
+import com.android.systemui.media.remedia.data.model.MediaDataModel
+import com.android.systemui.statusbar.phone.SystemUIDialog
+import com.android.systemui.statusbar.phone.SystemUIDialogFactory
+
+/**
+ * Expanded "now playing" card shown when the music island chip is tapped.
+ *
+ * Shows the title and subtitle, a seek bar with elapsed/total time, and previous, play/pause and
+ * next buttons. The card re-reads the session every [REFRESH_MS] so progress and button state stay
+ * live, and it dismisses itself once the session goes away.
+ *
+ * @param currentMedia returns the latest state of the session this card controls, or null if the
+ *   session is gone.
+ * @param seekTo seeks the session to the given position in milliseconds.
+ */
+class MusicControlsDialogDelegate(
+    private val context: Context,
+    private val dialogFactory: SystemUIDialogFactory,
+    private val currentMedia: () -> MediaDataModel?,
+    private val seekTo: (Long) -> Unit,
+) : SystemUIDialog.Delegate {
+
+    private val handler = Handler(Looper.getMainLooper())
+    private var ticker: Runnable? = null
+    private var dialog: SystemUIDialog? = null
+    private var isDragging = false
+
+    private lateinit var titleView: TextView
+    private lateinit var subtitleView: TextView
+    private lateinit var timeView: TextView
+    private lateinit var seekBar: SeekBar
+    private lateinit var prevButton: ImageButton
+    private lateinit var playButton: ImageButton
+    private lateinit var nextButton: ImageButton
+
+    override fun createDialog(): SystemUIDialog {
+        return dialogFactory.create(context, dialogDelegate = this)
+    }
+
+    override fun beforeCreate(dialog: SystemUIDialog, savedInstanceState: Bundle?) {
+        this.dialog = dialog
+        dialog.setContentView(buildView(dialog.context))
+        dialog.setOnDismissListener { stopTicker() }
+        // The first refresh happens right away so the card is never shown empty.
+        refresh()
+        startTicker()
+    }
+
+    private fun buildView(context: Context): View {
+        val density = context.resources.displayMetrics.density
+        fun dp(value: Int) = (value * density).toInt()
+
+        val root =
+            LinearLayout(context).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(dp(24), dp(24), dp(24), dp(16))
+            }
+
+        titleView =
+            TextView(context).apply {
+                textSize = 18f
+                setTypeface(null, Typeface.BOLD)
+                maxLines = 1
+                ellipsize = TextUtils.TruncateAt.END
+            }
+        subtitleView =
+            TextView(context).apply {
+                textSize = 14f
+                maxLines = 1
+                ellipsize = TextUtils.TruncateAt.END
+            }
+        timeView = TextView(context).apply { textSize = 12f }
+
+        seekBar =
+            SeekBar(context).apply {
+                setOnSeekBarChangeListener(
+                    object : SeekBar.OnSeekBarChangeListener {
+                        override fun onProgressChanged(
+                            seekBar: SeekBar,
+                            progress: Int,
+                            fromUser: Boolean,
+                        ) {
+                            if (fromUser) {
+                                timeView.text = formatTime(progress.toLong(), seekBar.max.toLong())
+                            }
+                        }
+
+                        override fun onStartTrackingTouch(seekBar: SeekBar) {
+                            isDragging = true
+                        }
+
+                        override fun onStopTrackingTouch(seekBar: SeekBar) {
+                            isDragging = false
+                            seekTo(seekBar.progress.toLong())
+                        }
+                    }
+                )
+            }
+
+        prevButton = controlButton(context)
+        playButton = controlButton(context)
+        nextButton = controlButton(context)
+        val buttons =
+            LinearLayout(context).apply {
+                orientation = LinearLayout.HORIZONTAL
+                gravity = android.view.Gravity.CENTER
+                addView(prevButton)
+                addView(playButton)
+                addView(nextButton)
+            }
+
+        root.addView(titleView)
+        root.addView(subtitleView)
+        root.addView(seekBar, LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT).apply { topMargin = dp(16) })
+        root.addView(timeView)
+        root.addView(buttons, LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT).apply { topMargin = dp(8) })
+        return root
+    }
+
+    private fun controlButton(context: Context): ImageButton {
+        val size = (48 * context.resources.displayMetrics.density).toInt()
+        return ImageButton(context).apply {
+            background = null
+            scaleType = android.widget.ImageView.ScaleType.CENTER_INSIDE
+            layoutParams = LinearLayout.LayoutParams(size, size)
+        }
+    }
+
+    private fun refresh() {
+        val media = currentMedia()
+        if (media == null) {
+            stopTicker()
+            dialog?.dismiss()
+            return
+        }
+
+        titleView.text = media.title
+        subtitleView.text = media.subtitle
+
+        val actions = media.playbackStateActions
+        bindButton(prevButton, actions?.prevOrCustom)
+        bindButton(playButton, actions?.playOrPause)
+        bindButton(nextButton, actions?.nextOrCustom)
+
+        val duration = media.durationMs.coerceAtLeast(1L)
+        seekBar.isEnabled = media.canBeScrubbed
+        seekBar.max = duration.coerceAtMost(Int.MAX_VALUE.toLong()).toInt()
+        if (!isDragging) {
+            seekBar.progress = media.positionMs.coerceIn(0L, duration).toInt()
+            timeView.text = formatTime(media.positionMs, duration)
+        }
+    }
+
+    private fun bindButton(button: ImageButton, action: MediaAction?) {
+        button.setImageDrawable(action?.icon)
+        button.contentDescription = action?.contentDescription
+        button.isEnabled = action?.action != null
+        button.setOnClickListener { action?.action?.run() }
+    }
+
+    private fun startTicker() {
+        val runnable =
+            object : Runnable {
+                override fun run() {
+                    refresh()
+                    handler.postDelayed(this, REFRESH_MS)
+                }
+            }
+        ticker = runnable
+        handler.post(runnable)
+    }
+
+    private fun stopTicker() {
+        ticker?.let { handler.removeCallbacks(it) }
+        ticker = null
+    }
+
+    private fun formatTime(positionMs: Long, durationMs: Long): String {
+        return "${formatOne(positionMs)} / ${formatOne(durationMs)}"
+    }
+
+    private fun formatOne(ms: Long): String {
+        val totalSeconds = (ms / 1000).coerceAtLeast(0L)
+        return "%d:%02d".format(totalSeconds / 60, totalSeconds % 60)
+    }
+
+    companion object {
+        private const val REFRESH_MS = 500L
+    }
+}
