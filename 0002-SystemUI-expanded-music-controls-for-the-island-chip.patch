 ) : OngoingActivityChipViewModel {
 
     /** The first active media session, or null when nothing is playing. */
@@ -76,20 +90,48 @@ constructor(
         }
 
     private fun MediaDataModel.toChipModel(): OngoingActivityChipModel.Active {
+        val sessionId = instanceId
         return OngoingActivityChipModel.Active(
             key = KEY,
             notificationKey = null, // Not tied to a notification
             icon = OngoingActivityChipModel.ChipIcon.SingleColorIcon(appIcon),
             content = OngoingActivityChipModel.Content.Text(title),
             colors = ColorsModel.SystemThemed,
-            clickBehavior = OngoingActivityChipModel.ClickBehavior.None,
+            clickBehavior =
+                OngoingActivityChipModel.ClickBehavior.ExpandAction(
+                    createDialogLaunchOnClickCallback(
+                        dialogDelegateCreator = { context ->
+                            MusicControlsDialogDelegate(
+                                context = context,
+                                dialogFactory = dialogFactory,
+                                currentMedia = { currentSession(sessionId) },
+                                seekTo = { to -> mediaRepository.seek(sessionId, to) },
+                            )
+                        },
+                        dialogTransitionAnimator = dialogTransitionAnimator,
+                        cuj = DIALOG_CUJ,
+                        key = KEY,
+                        instanceId = sessionId,
+                        uiEventLogger = uiEventLogger,
+                        logger = logger,
+                        tag = TAG,
+                    )
+                ),
+            instanceId = sessionId,
         )
     }
 
+    /** The latest state of the session with [sessionId], or null once it is gone. */
+    private fun currentSession(sessionId: InstanceId): MediaDataModel? =
+        mediaRepository.currentMedia.firstOrNull { it.instanceId == sessionId }
+
     companion object {
         /** Key used as the chip identity so the island can animate updates in place. */
         const val KEY = "MusicChip"
 
